rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signed(){return request.auth != null && request.auth.token.email_verified == true;}
  function admin(){return signed() && exists(/databases/$(database)/documents/sparkAdmins/$(request.auth.uid));}
  function me(){return get(/databases/$(database)/documents/sparkProfiles/$(request.auth.uid)).data;}
  function active(){return signed() && me().status == 'active';}
  function planActive(p){let id=p.get('planId','free');let path=/databases/$(database)/documents/sparkPlans/$(id);let plan=exists(path)?get(path).data:{'active':true,'price':0};return plan.get('active',true)==true&&(plan.get('price',0)==0||p.get('planExpiresAt',timestamp.value('2000-01-01T00:00:00Z'))>request.time);}
  function teacher(){return active() && me().role == 'teacher' && planActive(me());}
  function feature(c,f){let p=get(/databases/$(database)/documents/sparkProfiles/$(course(c).ownerUid)).data;let id=p.get('planId','free');let path=/databases/$(database)/documents/sparkPlans/$(id);let plan=exists(path)?get(path).data:{'features':{}};return admin()||(planActive(p)&&plan.get('features',{}).get(f,true)==true);}
  function course(c){return get(/databases/$(database)/documents/sparkCourses/$(c)).data;}
  function owner(c){return admin() || (teacher() && course(c).ownerUid == request.auth.uid);}
  function member(c){return active() && request.auth.uid in course(c).viewerUids;}
  function team(c){return active() && feature(c,'team') && exists(/databases/$(database)/documents/sparkCourses/$(c)/team/$(request.auth.uid));}
  function staff(c){return owner(c)||team(c);}
  function permission(c,p){return feature(c,'tracking')&&(owner(c)||(team(c)&&p in get(/databases/$(database)/documents/sparkCourses/$(c)/team/$(request.auth.uid)).data.permissions));}
  function unlocked(c){return course(c).closed == false;}
  function enrolled(c){return active() && feature(c,'courseAccess') && me().campus==course(c).campus && me().institution==course(c).institution && exists(/databases/$(database)/documents/sparkCourses/$(c)/students/$(request.auth.uid)) && get(/databases/$(database)/documents/sparkCourses/$(c)/students/$(request.auth.uid)).data.active == true && (course(c).free == true || get(/databases/$(database)/documents/sparkCourses/$(c)/students/$(request.auth.uid)).data.validUntil > request.time);}
  function validSubject(c,subject){return subject is string && subject in course(c).get('subjects',[]);}
  function questionLimit(c){let p=get(/databases/$(database)/documents/sparkProfiles/$(course(c).ownerUid)).data;let id=p.get('planId','free');let path=/databases/$(database)/documents/sparkPlans/$(id);return exists(path)?get(path).data.get('maxQuestions',10):10;}
  function allowedExam(c,e){let x=get(/databases/$(database)/documents/sparkCourses/$(c)/exams/$(e)).data;return enrolled(c)&&unlocked(c)&&x.published==true&&x.open==true&&x.startAt <= request.time && x.endAt > request.time;}
  match /sparkAdmins/{uid}{allow get:if signed()&&uid==request.auth.uid;allow list,write:if false;}
  match /sparkProfiles/{uid}{
   allow get:if signed()&&(uid==request.auth.uid||admin()||(teacher()&&resource.data.campus==me().campus&&resource.data.institution==me().institution&&resource.data.role=='student'));
   allow list:if admin()||(teacher()&&resource.data.campus==me().campus&&resource.data.institution==me().institution&&resource.data.role=='student');
   allow create:if admin()||(signed()&&uid==request.auth.uid&&request.resource.data.keys().hasOnly(['uid','name','email','phone','institution','campus','role','status','createdAt'])&&request.resource.data.uid==uid&&request.resource.data.email==request.auth.token.email&&request.resource.data.status=='pending'&&request.resource.data.role in ['student','teacher','staff']&&request.resource.data.name is string&&request.resource.data.name.size()<200&&request.resource.data.institution is string&&request.resource.data.campus is string&&request.resource.data.createdAt==request.time);
   allow update:if admin()||(teacher()&&resource.data.role=='student'&&resource.data.status=='pending'&&resource.data.campus==me().campus&&resource.data.institution==me().institution&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])&&request.resource.data.status=='active');allow delete:if admin()&&uid!=request.auth.uid;
  }
  match /sparkPlanPayments/{uid}{allow get:if signed()&&uid==request.auth.uid;allow list:if admin();allow create,update:if active()&&uid==request.auth.uid&&request.resource.data.keys().hasOnly(['uid','planId','cycle','receiptLink','createdAt'])&&request.resource.data.uid==uid&&request.resource.data.receiptLink is string&&request.resource.data.receiptLink.size()<2000&&request.resource.data.createdAt==request.time;allow delete:if admin();}
  match /sparkPlans/{id}{allow read:if signed();allow write:if admin();}
  match /sparkInvites/{c}{allow get:if signed();allow list:if admin();allow write:if owner(c)&&unlocked(c);}
  match /sparkCourses/{c}{
   allow get,list:if admin()||(active()&&(resource.data.ownerUid==request.auth.uid||request.auth.uid in resource.data.viewerUids));
   allow create:if admin()||(teacher()&&request.resource.data.ownerUid==request.auth.uid&&request.resource.data.institution==me().institution&&request.resource.data.campus==me().campus&&request.resource.data.closed==false);
   allow update:if admin()||(owner(c)&&unlocked(c)&&request.resource.data.ownerUid==resource.data.ownerUid&&request.resource.data.institution==resource.data.institution&&request.resource.data.campus==resource.data.campus);
   allow delete:if admin()&&resource.data.closed==true;
   match /team/{uid}{allow read:if staff(c)&&feature(c,'team');allow write:if owner(c)&&feature(c,'team')&&unlocked(c)&&request.resource.data.uid==uid&&request.resource.data.permissions.hasOnly(['observe','council','warnings'])&&get(/databases/$(database)/documents/sparkProfiles/$(uid)).data.status=='active'&&get(/databases/$(database)/documents/sparkProfiles/$(uid)).data.campus==course(c).campus&&get(/databases/$(database)/documents/sparkProfiles/$(uid)).data.institution==course(c).institution&&get(/databases/$(database)/documents/sparkProfiles/$(uid)).data.role in ['teacher','staff'];allow delete:if owner(c)&&unlocked(c);}
   match /requests/{uid}{allow read:if owner(c)||(signed()&&uid==request.auth.uid);allow create,update:if signed()&&uid==request.auth.uid&&request.resource.data.uid==uid&&request.resource.data.status=='pending'&&request.resource.data.keys().hasOnly(['uid','name','status','receiptLink','createdAt'])&&me().institution==course(c).institution&&me().campus==course(c).campus;allow delete:if owner(c);}
   match /students/{uid}{allow read:if staff(c)||(signed()&&uid==request.auth.uid);allow write:if owner(c)&&unlocked(c)&&request.resource.data.uid==uid&&get(/databases/$(database)/documents/sparkProfiles/$(uid)).data.role=='student'&&get(/databases/$(database)/documents/sparkProfiles/$(uid)).data.status=='active'&&get(/databases/$(database)/documents/sparkProfiles/$(uid)).data.campus==course(c).campus&&get(/databases/$(database)/documents/sparkProfiles/$(uid)).data.institution==course(c).institution;allow delete:if owner(c)&&unlocked(c);}
   match /lessons/{l}{allow read:if owner(c)||enrolled(c);allow create,update:if owner(c)&&unlocked(c)&&validSubject(c,request.resource.data.subject);allow delete:if owner(c)&&unlocked(c);}
   match /progress/{uid}{allow read:if staff(c)||(signed()&&uid==request.auth.uid);allow write:if enrolled(c)&&uid==request.auth.uid&&unlocked(c)&&request.resource.data.keys().hasOnly(['completed','updatedAt'])&&request.resource.data.completed is list&&request.resource.data.completed.size()<=500&&request.resource.data.updatedAt==request.time;}
   match /records/{id}{allow read:if staff(c)&&feature(c,'tracking');allow create:if unlocked(c)&&request.resource.data.authorUid==request.auth.uid&&request.resource.data.createdAt==request.time&&request.resource.data.kind in ['result','observation','verbal','written']&&((request.resource.data.kind=='result'&&validSubject(c,request.resource.data.subject)&&permission(c,'council'))||(request.resource.data.kind=='observation'&&permission(c,'observe'))||(request.resource.data.kind in ['verbal','written']&&feature(c,'warnings')&&permission(c,'warnings')));allow update,delete:if false;}
   match /exams/{e}{
    allow read:if owner(c)||(enrolled(c)&&resource.data.published==true);
    allow create,update:if owner(c)&&unlocked(c)&&validSubject(c,request.resource.data.subject)&&request.resource.data.questions is list&&request.resource.data.questions.size()>0&&request.resource.data.questions.size()<=questionLimit(c);
    allow delete:if false;
    match /private/{k}{allow read:if owner(c);allow write:if owner(c)&&unlocked(c);}
    match /attempts/{uid}{allow get:if owner(c)||(signed()&&uid==request.auth.uid);allow list:if owner(c);allow create:if signed()&&uid==request.auth.uid&&allowedExam(c,e)&&request.resource.data.keys().hasOnly(['uid','name','answers','submittedAt'])&&request.resource.data.uid==uid&&request.resource.data.name==me().name&&request.resource.data.answers is map&&request.resource.data.submittedAt==request.time;allow update,delete:if false;}
    match /grades/{uid}{allow get:if owner(c)||(signed()&&uid==request.auth.uid);allow list:if owner(c);allow write:if owner(c)&&unlocked(c);}
    match /events/{id}{allow read:if owner(c);allow create:if enrolled(c)&&unlocked(c)&&request.resource.data.uid==request.auth.uid&&request.resource.data.keys().hasOnly(['uid','type','createdAt'])&&request.resource.data.type in ['hidden','blur','copy','paste','contextmenu']&&request.resource.data.createdAt==request.time;allow update,delete:if false;}
    match /live/{s}{allow read:if owner(c)||enrolled(c);allow write:if owner(c)&&unlocked(c);}
    match /liveAnswers/{id}{allow read:if owner(c);allow create:if allowedExam(c,e)&&request.resource.data.uid==request.auth.uid&&request.resource.data.keys().hasOnly(['uid','name','questionId','answer','createdAt'])&&request.resource.data.name==me().name&&request.resource.data.createdAt==request.time&&get(/databases/$(database)/documents/sparkCourses/$(c)/exams/$(e)/live/state).data.open==true&&get(/databases/$(database)/documents/sparkCourses/$(c)/exams/$(e)/live/state).data.questionId==request.resource.data.questionId&&id==request.auth.uid+'_'+request.resource.data.questionId;allow update,delete:if false;}
   }
   match /{document=**}{allow read,write:if admin();}
   match /closures/{id}{allow read:if staff(c);allow create:if owner(c)&&unlocked(c)&&request.resource.data.authorUid==request.auth.uid&&request.resource.data.createdAt==request.time;allow update,delete:if admin();}
  }
  function bankEnabled(){let id=me().get('planId','free');let path=/databases/$(database)/documents/sparkPlans/$(id);return !exists(path)||get(path).data.get('features',{}).get('questionBank',true)==true;}
  match /sparkBank/{id}{allow read:if admin()||(teacher()&&bankEnabled()&&resource.data.ownerUid==request.auth.uid);allow create:if admin()||(teacher()&&bankEnabled()&&request.resource.data.ownerUid==request.auth.uid);allow update:if admin()||(teacher()&&bankEnabled()&&resource.data.ownerUid==request.auth.uid&&request.resource.data.ownerUid==resource.data.ownerUid);allow delete:if admin()||(teacher()&&bankEnabled()&&resource.data.ownerUid==request.auth.uid);}
  match /sparkLeads/{uid}{allow get:if signed()&&uid==request.auth.uid;allow list:if admin();allow create:if signed()&&uid==request.auth.uid&&request.resource.data.keys().hasOnly(['name','phone','email','createdAt'])&&request.resource.data.email==request.auth.token.email&&request.resource.data.name is string&&request.resource.data.name.size()<200&&request.resource.data.phone is string&&request.resource.data.phone.size()<40&&request.resource.data.createdAt==request.time;allow update,delete:if admin();}
  match /{document=**}{allow read,write:if false;}
 }
}
